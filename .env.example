# Environment variables for youtube-sync
# Copy to .env and fill in values as needed

# The port the server listens on (Railway/Render set this automatically)
PORT=3000

# Production or development
NODE_ENV=production

# Optional: enable Redis adapter for Socket.IO horizontal scaling
# Format: redis://:password@host:port
REDIS_URL=

# Optional: used only for constructing absolute URLs in UI if needed
BASE_URL=

# Optional: only if you add YouTube Data API search endpoints
YOUTUBE_API_KEY=
